# ── Networking (default VPC) ───────────────────────────────────────────────

data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
  filter {
    name   = "default-for-az"
    values = ["true"]
  }
}

# ── SSH key pair (generated by Terraform) ──────────────────────────────────

resource "tls_private_key" "ec2" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "ec2" {
  key_name   = "expense-tracker"
  public_key = tls_private_key.ec2.public_key_openssh
}

resource "local_sensitive_file" "private_key" {
  content         = tls_private_key.ec2.private_key_pem
  filename        = var.key_pem_output_path
  file_permission = "0400"
}

# ── Security group ─────────────────────────────────────────────────────────

resource "aws_security_group" "app" {
  name        = "expense-tracker-app"
  description = "Expense tracker: HTTP from world, SSH from operator"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.ssh_cidr]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# ── IAM instance profile (SSM access for break-glass shell) ────────────────

resource "aws_iam_role" "ec2" {
  name = "expense-tracker-ec2"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "ssm" {
  role       = aws_iam_role.ec2.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_instance_profile" "ec2" {
  name = "expense-tracker-ec2"
  role = aws_iam_role.ec2.name
}

# ── AMI lookup ─────────────────────────────────────────────────────────────

data "aws_ami" "al2023" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# ── EC2 instance ───────────────────────────────────────────────────────────

resource "aws_instance" "app" {
  ami                    = data.aws_ami.al2023.id
  instance_type          = var.instance_type
  subnet_id              = data.aws_subnets.default.ids[0]
  key_name               = aws_key_pair.ec2.key_name
  vpc_security_group_ids = [aws_security_group.app.id]
  iam_instance_profile   = aws_iam_instance_profile.ec2.name

  user_data = templatefile("${path.module}/user_data.sh.tpl", {
    github_repo_url = var.github_repo_url
  })

  root_block_device {
    volume_size = 30
    volume_type = "gp3"
    encrypted   = true
  }

  tags = {
    Name = "expense-tracker"
  }

  # AL2023 ships new AMIs frequently. Without this, every plan after an AMI
  # release would replace the instance — wiping the SQLite DB. Replace
  # deliberately by tainting: `terraform taint aws_instance.app`.
  lifecycle {
    ignore_changes = [ami]
  }
}

# ── Automated EBS snapshots (DLM) ──────────────────────────────────────────
# The root volume holds expenses.db and is delete-on-termination, so without
# these snapshots a terminated instance loses every expense row and user
# account permanently. Targeted by the Project tag rather than by volume id:
# default_tags puts that tag on whatever volume the instance currently has, so
# the policy keeps working after the instance is replaced.
#
# Snapshots are crash-consistent, not quiesced -- SQLite recovers from that the
# same way it recovers from power loss, so no app coordination is needed.

resource "aws_iam_role" "dlm" {
  name        = "expense-tracker-dlm"
  description = "Lets Data Lifecycle Manager snapshot the expense-tracker volume"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "dlm.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "dlm" {
  role       = aws_iam_role.dlm.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSDataLifecycleManagerServiceRole"
}

resource "aws_dlm_lifecycle_policy" "daily_snapshots" {
  description        = "expense-tracker daily volume snapshots"
  execution_role_arn = aws_iam_role.dlm.arn
  state              = "ENABLED"

  policy_details {
    resource_types = ["VOLUME"]

    target_tags = {
      Project = "expense-tracker"
    }

    schedule {
      name = "daily-${var.snapshot_retention_count}d"

      create_rule {
        interval      = 24
        interval_unit = "HOURS"
        times         = [var.snapshot_time_utc]
      }

      retain_rule {
        count = var.snapshot_retention_count
      }

      # Carry Project/ManagedBy onto the snapshots so they are attributable in
      # Cost Explorer and easy to find during a restore.
      copy_tags = true

      tags_to_add = {
        Name      = "expense-tracker-dlm-daily"
        CreatedBy = "dlm"
      }
    }
  }

  depends_on = [aws_iam_role_policy_attachment.dlm]
}

# ── Elastic IP ─────────────────────────────────────────────────────────────

resource "aws_eip" "app" {
  instance = aws_instance.app.id
  domain   = "vpc"

  tags = {
    Name = "expense-tracker"
  }
}
